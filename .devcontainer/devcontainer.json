{
  "name": "ticket-triage",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": true
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "ticket-triage",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "./mvnw -q -DskipTests package",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  }
}
